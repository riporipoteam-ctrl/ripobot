# Copy this file to .env and fill in your values. Never commit .env.

# Bot token from the Discord Developer Portal (Bot -> Token). Keep secret.
DISCORD_TOKEN=

# Application (client) ID from the Developer Portal (General Information).
CLIENT_ID=

# Your server (guild) ID. In Discord: Server Settings -> Widget, or enable
# Developer Mode and right-click the server name -> Copy Server ID.
GUILD_ID=

# Hugging Face API token for the 24/7 AI chat (optional).
# Get one free at https://huggingface.co/settings/tokens (read-only is enough).
# If left empty, chat features reply that chat is not configured; everything
# else keeps working.
HF_TOKEN=

# Chat model used for AI replies (optional).
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Voice messages (v7.2): speech-to-text via the ripo-stt Cloudflare Worker
# (Workers AI Whisper, free). If unset, voice messages get a friendly
# "couldn't hear you" fallback instead of transcription.
RIPO_STT_URL=https://ripo-stt.ripo-ripoteam.workers.dev
# Shared secret, must match the worker's STT_SECRET secret. Keep secret.
RIPO_STT_SECRET=
